{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && data.child('meta/createdAt').isNumber() && data.child('meta/createdAt').val() < (now - 43200000)",
        "meta": {
          ".write": "auth != null && ( !data.exists() || data.parent().child('host/uid').val() === auth.uid || data.parent().child('guest/uid').val() === auth.uid || ( newData.parent().child('guest/uid').val() === auth.uid && data.child('kind').val() !== 'group' ) || data.child('hostUid').val() === auth.uid )",
          ".validate": "newData.hasChildren(['status', 'createdAt']) && ( !data.hasChild('kind') || newData.child('kind').val() === data.child('kind').val() ) && ( !data.hasChild('hostUid') || newData.child('hostUid').val() === data.child('hostUid').val() ) && ( !data.hasChild('createdAt') || newData.child('createdAt').val() === data.child('createdAt').val() )",
          "status": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "kind": {
            ".validate": "newData.val() === '2p' || newData.val() === 'group'"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 1700000000000 && newData.val() <= (now + 60000)"
          },
          "capacity": {
            ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 12"
          },
          "minPlayers": {
            ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 12"
          },
          "partiyaMode": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "hostDeviceId": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "hostUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "contentRev": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "themes": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            }
          },
          "$other": {
            ".validate": "!newData.isString() || newData.val().length <= 512"
          }
        },
        "host": {
          ".write": "auth != null && ( !data.exists() || data.child('uid').val() === auth.uid )",
          ".validate": "newData.hasChildren(['deviceId', 'nickname', 'uid']) && newData.child('uid').val() === auth.uid",
          "deviceId": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "nickname": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "avatar": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "$other": {
            ".validate": "!newData.isString() || newData.val().length <= 512"
          }
        },
        "guest": {
          ".write": "auth != null && ( !data.exists() || data.child('uid').val() === auth.uid ) && root.child('rooms').child($code).child('meta/kind').val() !== 'group'",
          ".validate": "newData.hasChildren(['deviceId', 'nickname', 'uid']) && newData.child('uid').val() === auth.uid",
          "deviceId": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "nickname": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "avatar": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "$other": {
            ".validate": "!newData.isString() || newData.val().length <= 512"
          }
        },
        "players": {
          "$pid": {
            ".write": "auth != null && ( !data.exists() || data.child('uid').val() === auth.uid ) && ( root.child('rooms').child($code).child('meta/kind').val() === 'group' || newData.parent().parent().child('meta/kind').val() === 'group' )",
            ".validate": "newData.hasChildren(['deviceId', 'nickname', 'uid']) && newData.child('uid').val() === auth.uid",
            "deviceId": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "nickname": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "role": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "$other": {
              ".validate": "!newData.isString() || newData.val().length <= 512"
            }
          }
        },
        "messages": {
          "$msgId": {
            ".write": "auth != null && newData.exists() && ( root.child('rooms').child($code).child('host/uid').val() === auth.uid || root.child('rooms').child($code).child('guest/uid').val() === auth.uid || root.child('rooms').child($code).child('players').child(newData.child('from').val()).child('uid').val() === auth.uid )",
            ".validate": "newData.hasChildren(['from', 'type', 'ts']) && newData.child('from').isString() && newData.child('from').val().length <= 64 && ( ( newData.child('from').val() === root.child('rooms').child($code).child('host/deviceId').val() && root.child('rooms').child($code).child('host/uid').val() === auth.uid ) || ( newData.child('from').val() === root.child('rooms').child($code).child('guest/deviceId').val() && root.child('rooms').child($code).child('guest/uid').val() === auth.uid ) || root.child('rooms').child($code).child('players').child(newData.child('from').val()).child('uid').val() === auth.uid )",
            "type": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            }
          }
        }
      }
    },
    "lyudi": {
      "$pid": {
        ".read": "auth != null",
        ".write": "auth != null && $pid.length >= 8 && $pid.length <= 64 && ( !data.exists() || data.child('uid').val() === auth.uid )",
        ".validate": "newData.hasChildren(['nick','uid']) && newData.child('uid').val() === auth.uid",
        "nick": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "kody": {
      "$kod": {
        ".read": "auth != null",
        ".write": "auth != null && $kod.length === 6 && ( !data.exists() || data.child('uid').val() === auth.uid )",
        ".validate": "newData.hasChildren(['pid','uid']) && newData.child('uid').val() === auth.uid && root.child('lyudi').child(newData.child('pid').val()).child('uid').val() === auth.uid",
        "pid": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "zayavki": {
      "$komu": {
        ".read": "auth != null && root.child('lyudi').child($komu).child('uid').val() === auth.uid",
        ".write": "auth != null && !newData.exists() && root.child('lyudi').child($komu).child('uid').val() === auth.uid",
        "$otkogo": {
          ".write": "auth != null && $komu.length <= 64 && $otkogo.length <= 64 && root.child('lyudi').child($komu).exists() && ( ( newData.exists() && root.child('lyudi').child($otkogo).child('uid').val() === auth.uid ) || ( !newData.exists() && ( root.child('lyudi').child($komu).child('uid').val() === auth.uid || root.child('lyudi').child($otkogo).child('uid').val() === auth.uid ) ) )",
          ".validate": "newData.hasChildren(['nick','uid']) && newData.child('uid').val() === auth.uid",
          "nick": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "avatar": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "otvety": {
      "$komu": {
        ".read": "auth != null && root.child('lyudi').child($komu).child('uid').val() === auth.uid",
        ".write": "auth != null && !newData.exists() && root.child('lyudi').child($komu).child('uid').val() === auth.uid",
        "$otkogo": {
          ".write": "auth != null && $komu.length <= 64 && $otkogo.length <= 64 && ( ( newData.exists() && root.child('lyudi').child($otkogo).child('uid').val() === auth.uid && root.child('zayavki').child($otkogo).child($komu).exists() ) || ( !newData.exists() && ( root.child('lyudi').child($komu).child('uid').val() === auth.uid || root.child('lyudi').child($otkogo).child('uid').val() === auth.uid ) ) )",
          ".validate": "newData.hasChildren(['ok','nick','uid']) && newData.child('ok').isBoolean() && newData.child('ok').val() === true && newData.child('uid').val() === auth.uid",
          "ok": {
            ".validate": "newData.isBoolean()"
          },
          "nick": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "avatar": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "druzya": {
      "$chey": {
        ".read": "auth != null && root.child('lyudi').child($chey).child('uid').val() === auth.uid",
        ".write": "auth != null && root.child('lyudi').child($chey).child('uid').val() === auth.uid",
        "$drug": {
          ".validate": "!newData.exists() || ( newData.hasChildren(['nick']) && $drug.length <= 64 )",
          "nick": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "avatar": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "zovy": {
      "$komu": {
        ".read": "auth != null && root.child('lyudi').child($komu).child('uid').val() === auth.uid",
        ".write": "auth != null && !newData.exists() && root.child('lyudi').child($komu).child('uid').val() === auth.uid",
        "$zov": {
          ".write": "auth != null && $komu.length <= 64 && ( ( newData.exists() && root.child('lyudi').child(newData.child('ot/pid').val()).child('uid').val() === auth.uid && root.child('druzya').child($komu).child(newData.child('ot/pid').val()).exists() ) || ( !newData.exists() && root.child('lyudi').child($komu).child('uid').val() === auth.uid ) )",
          ".validate": "newData.hasChildren(['code','ot','ts'])",
          "code": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "kind": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "ot": {
            ".validate": "newData.hasChildren(['pid','nick'])",
            "pid": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "nick": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}

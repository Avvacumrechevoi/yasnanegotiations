node_modules/
.env
*.log

# Билд-артефакты в корне проекта — игнорируем,
# но docs/dist/ И docs/preview/dist/ оставляем в git:
# GitHub Pages деплоит docs/, поэтому bundle должен быть закоммичен.
dist/
!docs/dist/
!docs/dist/**
!docs/preview/dist/
!docs/preview/dist/**

.DS_Store

# Playwright
test-results/
playwright-report/
.claude/launch.json

# Неминифицированные бандлы в публикацию не идут: на них не ссылается ни одна
# страница, а это 3,5 МБ полностью читаемого исходника в открытом доступе.
# Сборщик их по-прежнему делает — они нужны для отладки, но остаются локальными.
.build/

# Ключи и секреты. В .github/workflows/deploy-backend.yml есть подсказка
# выполнить команду, создающую sa-key.json с ключом от облака: выполни её
# кто-нибудь в папке проекта — и файл уехал бы в коммит.
sa-key*.json
*key*.json
!package-lock.json
.env.*
*.pem
*.p12
*.pfx
secrets*.json

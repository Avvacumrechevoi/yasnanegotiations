<?xml version="1.0" encoding="utf-8"?>
<!-- Цвета приложения. colorPrimary и соседи приходят из библиотеки Capacitor
     в её умолчаниях (индиго #3F51B5) — перекрываем своими: цвет приложения
     обязан совпадать с сайтом и со знаком, иначе системные элементы
     (выделение текста, индикатор обновления) окажутся чужого оттенка. -->
<resources>
    <color name="colorPrimary">#0071e3</color>
    <color name="colorPrimaryDark">#0B57C0</color>
    <color name="colorAccent">#0071e3</color>
    <!-- Заставка и фон окна: глубокий зелёный знака Ясны — тот же, что
         у веб-заставки на главной, чтобы стык был незаметен. -->
    <color name="splashBackground">#0e3f47</color>
</resources>
